# WhereAreMySats - example environment (optional with Node Settings UI)
# Copy to .env and fill in real values. .env must never be committed.

# --- Bitcoin Core RPC ---
# Saved /app/data/node-settings.json overrides all RPC environment fields.
# Leave credentials blank for first-run setup through Node Settings.
# For environment-only setup use your own DNS name/IP, username and password.
BTC_RPC_HOST=
BTC_RPC_PORT=8332
BTC_RPC_USER=
BTC_RPC_PASSWORD=
# Network this node runs: mainnet | testnet | signet | regtest
BTC_NETWORK=mainnet
# Set to 1 for a trusted HTTPS RPC proxy (certificate verification stays on).
BTC_RPC_TLS=0
# Optional legacy URL form; overrides separate RPC environment fields:
# BTC_RPC_URL=http://<RPC-USER>:<URL-ENCODED-PASSWORD>@<RPC-HOST>:8332/

# Docker published HTTP address/port. Default 127.0.0.1: reachable only on
# this host (SSH tunnel, local reverse proxy). For LAN access set 0.0.0.0 or
# one host address; WAMS has no login, so everyone who reaches the port is an
# operator. Docker publishing bypasses ufw rules.
WAMS_BIND_ADDRESS=127.0.0.1
WAMS_HTTP_PORT=8080
# Host names (besides IP addresses and localhost) under which the browser opens
# WAMS, comma-separated, e.g. the name of a reverse proxy. Requests for any
# other name are rejected with 400 (protection against DNS rebinding).
# WAMS_ALLOWED_HOSTS=wams.example

# --- Application ---
# Listen address inside the container (compose sets it; keep 0.0.0.0 there).
# For a direct start without Docker the default is 127.0.0.1.
APP_HOST=0.0.0.0
APP_PORT=8080
DATA_DIR=/app/data

# --- Safety limits ---
# MAX_TRACE_DEPTH is capped at 400; higher values are clamped.
MAX_TRACE_DEPTH=100

# --- Caching ---
CACHE_ENABLED=1

# --- Documentation Coverage execution budgets ---
# Overall wall-clock budget (seconds) for one Documentation Coverage run.
# Reaching it returns HTTP 503 ("execution limit reached or evidence changed").
COVERAGE_TIMEOUT=30
# Concurrent live gettxout RPC workers during Coverage verification (clamped 1-32).
COVERAGE_RPC_CONCURRENCY=8
# Maximum outpoints Coverage may evaluate before the execution limit is reached.
COVERAGE_MAX_OUTPOINTS=100000
# Maximum transactions Coverage may traverse before the execution limit is reached.
COVERAGE_MAX_TRANSACTIONS=10000

# --- Acquisition position derivation budgets ---
# Overall wall-clock budget (seconds) for position derivation (fail-closed).
POSITION_TIMEOUT=10
# Freshness TTL (seconds) for cached spend facts used by position derivation.
POSITION_SPEND_TTL=5

# --- Local Electrs fallback for reverse address discovery (optional) ---
# Address discovery prefers Bitcoin Core scanblocks (local blockfilter index).
# If the node has no blockfilterindex AND you run a local electrs,
# point this at it. tcp:// is plaintext, ssl:// is TLS. Leave empty to disable.
# ELECTRS_URL=tcp://127.0.0.1:50001
# ELECTRS_TIMEOUT=10
